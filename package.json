{
  "name": "regapro-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@regapro/web",
    "clean": "node scripts/clean-build-artifacts.mjs",
    "build:packages": "tsc -b tsconfig.build.json",
    "build": "npm run build:packages && npm run build --workspace=@regapro/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "test": "npm run build:packages && npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:gen-types": "node scripts/gen-supabase-types.mjs",
    "db:bootstrap-org": "node scripts/bootstrap-regapro-org.mjs",
    "db:verify-live": "node scripts/verify-live-connection.mjs",
    "db:test-rls": "node scripts/rls-integration/run.mjs",
    "smoke:supabase-mode": "node scripts/smoke-supabase-mode.mjs",
    "smoke:cloud-runtime": "node --env-file=apps/web/.env.local scripts/smoke-cloud-runtime.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "adm-zip": "0.6.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
